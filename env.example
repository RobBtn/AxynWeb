# Copier en .env.local et renseigner. Ne jamais versionner .env.local.
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_CLIENT_EMAIL=
DEMO_CLIENT_PASSWORD=
# Cle API Claude : permet a l'IA de creer et retoucher les sites depuis l'admin.
ANTHROPIC_API_KEY=

# Envoi d'e-mails (code de verification a l'inscription). Sans SMTP en production,
# les inscriptions sont fermees. En developpement, le code s'affiche dans la console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Expediteur, par exemple : AxynWeb <contact@axynweb.fr>
SMTP_FROM=
# Mettre false pour fermer les inscriptions publiques.
SIGNUP_OPEN=true

# Domaines de clients : noms qui servent la plateforme elle-meme (separes par des virgules).
# Toute autre visite est traitee comme le domaine d'un client.
PLATFORM_HOSTS=axynweb.fr,www.axynweb.fr,localhost,127.0.0.1
# Adresse IP publique du serveur : a donner aux clients pour l'enregistrement DNS, et
# utilisee par l'admin pour verifier qu'un domaine pointe bien vers le serveur.
SERVER_IP=
